<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<component type="addon">
    <id>org.freedesktop.LinuxAudio.Plugins.UhhyouPlugins</id>
    <extends>org.freedesktop.LinuxAudio.BaseExtension</extends>
    <name>UhhyouPlugins</name>
    <summary>Uhhyou Plugins VST3</summary>
    <project_license>GPL-3.0</project_license>
    <metadata_license>CC0-1.0</metadata_license>
    <developer_name>Uhhyou Developers</developer_name>
    <description>
      <p>Uhhyou audio plugins in VST3. It contains the following synthesizers:</p>
      <ul>
        <li>ClangSynthh</li>
        <li>CollidingCombSynth</li>
        <li>CubicPadSynth</li>
        <li>DoubleLoopCymbal</li>
        <li>EnvelopedSine</li>
        <li>FDNCymbal</li>
        <li>GenericDrum</li>
        <li>IterativeSinCluster</li>
        <li>MaybeSnare</li>
        <li>MembraneSynth</li>
        <li>LightPadSynth</li>
        <li>SyncSawSynth</li>
        <li>TrapezoidSynth</li>
        <li>UltraSynth</li>
        <li>WaveCymbal</li>
      </ul>
      <p>It contains the following effects:</p>
      <ul>
        <li>AccumulativeRingMod</li>
        <li>BasicLimiter</li>
        <li>CombDistortion</li>
        <li>EsPhaser</li>
        <li>FDN64Reverb</li>
        <li>FeedbackPhaser</li>
        <li>GlitchSprinkler</li>
        <li>L4Reverb</li>
        <li>LatticeReverb</li>
        <li>LongPhaser</li>
        <li>MiniCliffEQ</li>
        <li>NarrowingDelay</li>
        <li>OrdinaryPhaser</li>
        <li>ParallelComb</li>
        <li>ParallelDetune</li>
        <li>PitchShiftDelay</li>
        <li>RingModSpacer</li>
        <li>SevenDelay</li>
        <li>SpectralPhaser</li>
        <li>UltrasonicRingMod</li>
      </ul>
    </description>
    <update_contact>hub_AT_figuiere.net</update_contact>
    <url type="homepage">https://ryukau.github.io/VSTPlugins/</url>
    <releases>
      <release version="0.69.0" date="2025-12-21">
        <url>https://github.com/ryukau/VSTPlugins/releases/tag/UhhyouPlugins0.69.0</url>
        <description>
          <p>Fix latency reporting (#61)</p>
        </description>
      </release>
      <release version="0.68.0" date="2025-12-16">
        <url>https://github.com/ryukau/VSTPlugins/releases/tag/UhhyouPlugins0.68.0</url>
        <description>
          <p>FeedbackPhaser 0.1.6</p>
          <ul>
            <li>Fixed a bug that when Modulation -&gt; Type is set to
            Lin. Mul. or Add, and Mod. Asym. is set to ±1, saving and
            loading the plugin changed the sound.</li>
          </ul>
          <p>MembraneSynth 0.1.11</p>
          <ul>
            <li>Added randomize buttons.</li>
          </ul>
        </description>
      </release>
      <release version="0.67.0" date="2025-09-02">
        <url>https://github.com/ryukau/VSTPlugins/releases/tag/UhhyouPlugins0.67.0</url>
        <description>
          <p>Fixed a bug that GlitchSprinkler output silence when
          Bitwise And parameter was enabled.</p>
        </description>
      </release>
      <release version="0.66.0" date="2025-08-30">
        <url>https://github.com/ryukau/VSTPlugins/releases/tag/UhhyouPlugins0.66.0</url>
        <description>
          <ul>
            <li>Added GUI scaling. To use the option, add guiScale to
            style.json. Details are available on "GUI Style
            Configuration" section on the manual page.</li>
            <li>Added allpass loop gain parameters to
            DoubleLoopCymbal. The parameters can be used to reduce the
            decay time, but the texture becomes less metallic.</li>
            <li>Fixed a bug on BarBox that the "ascending sort"
            shortcut was disabled.</li>
            <li>Updated the Linux patch for VSTGUI4. This solves the
            crash on the issue #54, and the incorrect rendering of
            arc, ellipse, and polygon.</li>
          </ul>
        </description>
      </release>
      <release version="0.65.0" date="2024-11-15">
        <url>https://github.com/ryukau/VSTPlugins/releases/tag/UhhyouPlugins0.65.0</url>
      </release>
      <release version="0.64.0" date="2024-10-24">
        <url>https://github.com/ryukau/VSTPlugins/releases/tag/UhhyouPlugins0.64.0</url>
      </release>
      <release version="0.63.0" date="2024-10-11">
        <url>https://github.com/ryukau/VSTPlugins/releases/tag/UhhyouPlugins0.63.0</url>
      </release>
      <release version="0.62.0" date="2024-08-11">
        <description>
          <p>Added a new plugin GlitchSprinkler.</p>
        </description>
      </release>
      <release version="0.61.0" date="2023-12-28">
        <description>
          <p>Fix GUI bug</p>
        </description>
      </release>
      <release version="0.59.0" date="2023-12-01">
        <description>
          <ul>
            <li>Added randomization button to ClangCymbal.</li>
          </ul>
        </description>
      </release>
      <release version="0.58.0" date="2023-10-22">
        <description>
          <p>Added a randomization button to GenericDrum.</p>
        </description>
      </release>
      <release version="0.52.0" date="2023-01-27" />
    </releases>
</component>
